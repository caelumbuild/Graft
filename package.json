{
  "name": "@caelumbuild/context-graph",
  "version": "0.8.2",
  "description": "Caelum Build's deterministic, local-only repository context graph and blast-radius toolkit.",
  "keywords": [
    "local-only",
    "code-intelligence",
    "knowledge-graph",
    "context",
    "codebase",
    "blast-radius",
    "caelum-build"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caelumbuild/Graft.git"
  },
  "homepage": "https://github.com/caelumbuild/Graft#readme",
  "bugs": {
    "url": "https://github.com/caelumbuild/Graft/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "caelum-graph": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p viewer/tsconfig.json && node scripts/build-viewer.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "cli": "tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.113.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "openai": "^6.45.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.1.0",
    "d3-force": "^3.0.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
